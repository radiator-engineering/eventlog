load("drove/reactors.star", "reactor")

# Everything here runs the `eventlog` binary this repo ships
# (`cargo install --path .`), not the retired shell toolkit.

protect_log = task(
    "protect-log",
    check = ["eventlog", "protect", "--status"],
    run = ["eventlog", "protect"],
    auto = False,
)

control = workspace("control", panes = [
    herdr.tab("coordinator", split = herdr.DOWN, ratios = [0.5], panes = [
        # The pane that runs `drove up` becomes the controller; no second agent is started.
        caller_pane("controller"),
        pane("eventlog", serve = ["eventlog", "view", "-f"]),
    ]),
    herdr.tab("monitor: system + agents", split = herdr.RIGHT, ratios = [0.5], panes = [
        pane("agentmon", serve = any_of(["agentmon", "--since", "launch"], ["htop"])),
        pane("state", serve = ["eventlog", "tui"]),
    ]),
])

maintenance = workspace("maintenance", panes = [
    herdr.tab("lazygit", panes = [pane("gitlog", serve = any_of(["lazygit"], ["bash"]))]),
    reactor("commit", agent = "cursor-committer", model = "composer-2.5-fast",
            on = "result", action = "commit-action.sh", git = True),
    reactor("doc-sync", agent = "doc-worker", model = "sonnet",
            on = "ack", filters = ["by=cursor-committer", "outcome=committed"],
            action = "doc-action.sh", after = ["commit-reactor"]),
])

profile("default", workspaces = [control, maintenance], tasks = [protect_log])
