# Sourced by the reactors in .context/bin. Shell env wins over these defaults.
: "${MODEL:=composer-2.5-fast}"          # committer (cursor-agent) model
: "${DOC_MODEL:=sonnet}"            # doc worker (claude -p) model
: "${DOC_PATHS:=docs,README.md,AGENTS.md}"            # doc roots the doc worker may edit
: "${PASS_TIMEOUT:=300}"
: "${REACTOR_RUNTIME:=eventlog}"   # eventlog react (the Rust runtime) | shell (.context/bin/*-reactor.sh)
export MODEL DOC_MODEL DOC_PATHS PASS_TIMEOUT REACTOR_RUNTIME
